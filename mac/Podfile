#source 'https://github.com/CocoaPods/Specs.git'
workspace 'TeamTalk.xcworkspace'

target 'TeamTalk' do
  platform :osx, '10.8'

  pod 'FMDB', '~> 2.3'
  pod 'AFNetworking', '~> 2.5.0'
  pod 'ProtocolBuffers', '~> 1.9.4'
end

# Xcode 26 默认把一批告警当错误（-Werror=return-type / deprecated-objc-isa-usage
# / objc-root-class / implicit-function-declaration / non-modular-include 等），
# 本项目依赖的都是老 pod，无法在新编译器下满足这些约束，统一降级为普通告警。
post_install do |installer|
  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      config.build_settings['GCC_TREAT_WARNINGS_AS_ERRORS'] = 'NO'
      config.build_settings['CLANG_WARN_DEPRECATED_OBJC_ISA_USAGE'] = 'NO'
      config.build_settings['CLANG_WARN_OBJC_ROOT_CLASS'] = 'NO'
      config.build_settings['GCC_WARN_ABOUT_RETURN_TYPE'] = 'NO'
      # AFNetworking 等老 pod 以 framework(target 带 module) 编译时，
      # 会 include 系统私有头（如 netinet6/in6.h），Xcode 26 在
      # ScanDependencies 阶段用 -Werror=non-modular-include-in-framework-module
      # 直接报硬错误，仅靠 -Wno-error 无法压掉。必须显式允许非模块内 include。
      config.build_settings['CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES'] = 'YES'
      config.build_settings['OTHER_CFLAGS'] = '$(inherited) -Wno-error=return-type -Wno-error=implicit-function-declaration -Wno-error=deprecated-objc-isa-usage -Wno-error=objc-root-class -Wno-error=non-modular-include-in-framework-module -Wno-non-modular-include-in-framework-module'
    end
  end

  # Xcode 26 把 netinet6/in6.h 视为私有头：在模块（framework target）内
  # #include 它触发 "Use of private header from outside its module" 硬错误，
  # 属于模块映射校验，-Werror 降级与 CLANG_ALLOW_..._MODULES 均无效。
  # AFNetworking 2.x 的 AFNetworkReachabilityManager.h 就 include 了它，
  # 换成公开头 netinet/in.h 即可（同样提供 struct sockaddr_in6 / IPv6 宏）。
  Dir.glob(File.join(installer.sandbox.root, 'AFNetworking', '**', '*.{h,m}')).each do |f|
    src = File.read(f)
    if src.include?('#include <netinet6/in6.h>')
      src = src.gsub('#include <netinet6/in6.h>', '#include <netinet/in.h>')
      File.write(f, src)
      puts "patched #{File.basename(f)}: netinet6/in6.h -> netinet/in.h"
    end
  end
end
